{
  "actions": {
    "ImageTranslateLLM": {
      "document": "This API is used to provide translation service for images in 18 languages. It can automatically recognize text content in images and translate it into the target language. The recognized text is translated line by line, and a version that supports paragraph translation will be offered subsequently.\n\n-Input image format: png, jpg, jpeg and other common image formats. gif animation is not supported.\n-Output image format: jpg.\n\nNotification: For general developers, we recommend prioritizing SDK integration to simplify development. For SDK usage introduction, directly view the 5. Developer Resources part.",
      "input": "ImageTranslateLLMRequest",
      "name": "End-to-end image translation",
      "output": "ImageTranslateLLMResponse",
      "status": "online"
    }
  },
  "metadata": {
    "apiVersion": "2018-03-21",
    "serviceNameCN": "机器翻译",
    "serviceShortName": "tmt"
  },
